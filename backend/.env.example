# Entorno de aplicación (Twelve-Factor App)
NODE_ENV=development
PORT=3100
LOG_LEVEL=info

# Origen permitido de la tienda (CORS estricto)
CORS_TIENDA_ORIGIN=http://localhost:5173

# MariaDB local compartida con SVA CRM (sva_online)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sva_online
DB_USER=root
DB_PASSWORD=123456
DB_POOL_LIMIT=10

# Ruta hacia la carpeta sva_online para compartir uploads de comprobantes e imágenes
SVA_ROOT_DIR=../../sva_online

# Autenticación JWT Stateless (generar secreto aleatorio >= 32 bytes)
JWT_ACCESS_SECRET=REEMPLAZAR_CON_SECRETO_ALEATORIO_LARGO_DE_32_BYTES
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=7
COOKIE_SECURE=false

# Idempotencia y protección contra abuso
IDEMPOTENCY_TTL_HOURS=24
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
